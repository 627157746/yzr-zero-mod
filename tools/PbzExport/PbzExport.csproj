<Project Sdk="Microsoft.NET.Sdk">
  <!-- 影之刃零资源导出工具，基于 CUE4Parse 源码（位置由 tools\env.ps1 的 PBZ_CUE4PARSE 提供） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(PBZ_CUE4PARSE)\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="$(PBZ_CUE4PARSE)\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>

  <Target Name="CheckCue4ParsePath" BeforeTargets="Restore;BeforeBuild">
    <Error Condition="'$(PBZ_CUE4PARSE)' == ''" Text="未设置 PBZ_CUE4PARSE，请先在 PowerShell 中执行 . tools\env.ps1" />
  </Target>
</Project>

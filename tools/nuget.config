<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 构建时用 -p:RestoreConfigFile 指定本文件，只从 nuget.org 还原。注意：NuGet 仍会在 %APPDATA%\NuGet 生成一个默认的 NuGet.Config（实测） -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
